# Copy to .env.local and fill in. On your host, add the same values as environment variables.

# Required. Create a key at https://resend.com/api-keys
RESEND_API_KEY=

# Optional. Leave unset to use Resend's test sender, which only delivers to the email
# address that owns the Resend account. Set it once you've verified a domain in Resend.
# CONTACT_FROM_EMAIL=Portfolio <hello@your-domain.com>
